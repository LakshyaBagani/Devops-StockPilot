# Optional remote state in S3. Local state (git-ignored) stays the default; keep it until
# terraform destroy completes.
#
# To switch:
#   1. Create the bucket outside Terraform (replace ACCOUNT_ID with your 12-digit account id):
#        B=stockpilot-tfstate-ACCOUNT_ID
#        aws s3api create-bucket --bucket "$B" --region ap-south-1 --create-bucket-configuration LocationConstraint=ap-south-1
#        aws s3api put-bucket-versioning --bucket "$B" --versioning-configuration Status=Enabled
#        aws s3api put-public-access-block --bucket "$B" --public-access-block-configuration BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
#   2. Raise required_version in versions.tf to ">= 1.11.0": use_lockfile is the S3-native lock,
#      so no DynamoDB table is needed.
#   3. Rename this file to backend.tf, set the bucket name, then:
#        terraform -chdir=terraform init -migrate-state
#   4. This root never manages the bucket, so terraform destroy cannot delete the state it is using.
terraform {
  backend "s3" {
    bucket       = "stockpilot-tfstate-ACCOUNT_ID"
    key          = "eks/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}
