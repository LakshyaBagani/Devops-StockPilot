# Local overrides for docker compose. Copy to .env (git-ignored): cp .env.example .env
# Local development values only. Never put real credentials here or in .env.

# Password of the compose Postgres. Local only: its port is never published.
POSTGRES_PASSWORD=localdev

# Host address of the published ports 3000 (UI) and 8000 (API).
# 0.0.0.0 exposes them on your LAN, e.g. to try the UI from a phone.
BIND_ADDR=127.0.0.1

# Build stamp reported by /api/version and the UI footer.
# make up overrides it with the current commit SHA (the shell env beats .env).
GIT_SHA=dev
