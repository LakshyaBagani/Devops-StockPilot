# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
# Same as line-length in backend/pyproject.toml (ruff).
max_line_length = 100

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{tf,tfvars,hcl}]
indent_size = 2

[*.sh]
indent_size = 2
